SELECT *
FROM Flight
WHERE Status = 'Scheduled';


SELECT *
FROM Airline
ORDER BY Name ASC;

SELECT
    f.FlightNumber,
    a.Name AS Airline,
    f.Status
FROM Flight f
JOIN Aircraft ac
ON f.AircraftID = ac.AircraftID
JOIN Airline a
ON ac.AirlineID = a.AirlineID;

SELECT COUNT(*) AS TotalPassengers
FROM Passenger;


SELECT
    p.FirstName,
    p.LastName,
    b.BookingDate,
    b.Status
FROM Passenger p
JOIN Booking b
ON p.PassengerID = b.PassengerID;

SELECT
    p.FirstName,
    p.LastName,
    b.BookingID,
    b.BookingDate,
    b.Status
FROM Passenger p
JOIN Booking b
ON p.PassengerID = b.PassengerID;


SELECT
    p.FirstName,
    p.LastName,
    t.TicketNumber,
    t.Class
FROM Passenger p
JOIN Booking b
ON p.PassengerID = b.PassengerID
JOIN Ticket t
ON b.BookingID = t.BookingID;

SELECT
    FlightNumber,
    Status,
    AircraftID
FROM Flight
ORDER BY FlightNumber ASC;


SELECT COUNT(*) AS TotalFlights
FROM Flight;


SELECT
    a.Name,
    COUNT(f.FlightID) AS TotalFlights
FROM Airline a
JOIN Aircraft ac
ON a.AirlineID = ac.AirlineID
JOIN Flight f
ON ac.AircraftID = f.AircraftID
GROUP BY a.Name;



SELECT
AVG(Capacity) AS AverageCapacity
FROM Aircraft;



SELECT
MAX(FlightHours) AS HighestHours
FROM Pilot;


SELECT
MIN(Capacity) AS MinimumCapacity
FROM Aircraft;


SELECT
UPPER(FirstName) AS FirstName,
UPPER(LastName) AS LastName
FROM Passenger;


SELECT
FirstName,
LastName,
DATE_PART('year', AGE(DateOfBirth)) AS Age
FROM Passenger;


SELECT *
FROM Flight
WHERE AircraftID IN
(
    SELECT AircraftID
    FROM Aircraft
    WHERE Capacity > 200
);

SELECT AircraftID, Model, Capacity
FROM Aircraft
ORDER BY Capacity DESC;

SELECT
    p.FirstName,
    p.LastName,
    f.FlightNumber,
    a.Name AS Airline
FROM Passenger p
JOIN Booking b
ON p.PassengerID = b.PassengerID
JOIN Flight f
ON b.FlightID = f.FlightID
JOIN Aircraft ac
ON f.AircraftID = ac.AircraftID
JOIN Airline a
ON ac.AirlineID = a.AirlineID;


SELECT DISTINCT Country
FROM Airport;

SELECT *
FROM Passenger
WHERE FirstName LIKE 'A%';

SELECT *
FROM Aircraft
WHERE Capacity BETWEEN 180 AND 350;

SELECT *
FROM Flight
WHERE Status IN ('Scheduled','Completed');


SELECT *
FROM Airline
WHERE Email IS NOT NULL;

SELECT
p.PassengerID,
p.FirstName,
b.BookingID
FROM Passenger p
LEFT JOIN Booking b
ON p.PassengerID=b.PassengerID;


SELECT
b.BookingID,
t.TicketNumber
FROM Booking b
RIGHT JOIN Ticket t
ON b.BookingID=t.BookingID;

SELECT *
FROM Employee
NATURAL JOIN Pilot;

SELECT *
FROM Passenger p
WHERE EXISTS
(
SELECT 1
FROM Booking b
WHERE b.PassengerID=p.PassengerID
);

SELECT
    Status,
    COUNT(*) AS TotalFlights
FROM Flight
GROUP BY Status
HAVING COUNT(*) >= 1;

SELECT
    LOWER(FirstName) AS FirstName,
    LOWER(LastName) AS LastName
FROM Passenger;

SELECT
    SUM(Capacity) AS TotalCapacity
FROM Aircraft;

